{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProofGate Ops proof receipt",
  "type": "object",
  "required": ["run_id", "source_id", "fingerprint", "decision", "status", "steps", "output_object_ids"],
  "properties": {
    "run_id": {"type": "string"},
    "source_id": {"type": "string"},
    "fingerprint": {"type": "string"},
    "decision": {"enum": ["ACTION", "REVIEW", "NO_ACTION"]},
    "status": {"type": "string"},
    "steps": {"type": "array"},
    "output_object_ids": {"type": "object"},
    "errors": {"type": "array"},
    "replay_of_run_id": {"type": ["string", "null"]}
  }
}
